---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/inter-tight/700.css';
import interTight700 from '@fontsource/inter-tight/files/inter-tight-latin-700-normal.woff2?url';
import '../styles/global.css';
import { site, getSeoTitle, getSeoDescription } from '../lib/site';
import Analytics from '../components/Analytics.astro';
import Tracking from '../components/Tracking.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
	title?: string;
	description?: string;
	page?: 'home' | 'obrigado';
}

const {
	title = getSeoTitle(),
	description = getSeoDescription(),
	page = 'home',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(`${base}${site.ogImage}`, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="preload" href={interTight700} as="font" type="font/woff2" crossorigin />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content={String(site.ogImageWidth)} />
		<meta property="og:image:height" content={String(site.ogImageHeight)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		{site.city && <meta name="geo.placename" content={site.city} />}
		<script is:inline>window.dataLayer = window.dataLayer || [];</script>
		<Analytics part="head" />
		{page === 'home' && <JsonLd canonical={canonical} />}
	</head>
	<body class="bg-surface font-sans text-zinc-900 antialiased">
		<Analytics part="body" />
		<slot />
		<Tracking page={page} />
	</body>
</html>
