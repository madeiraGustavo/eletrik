---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaButton from '../components/CtaButton.astro';
import { getSeoTitle } from '../lib/site';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<Layout
	page="obrigado"
	title={`Mensagem enviada | ${getSeoTitle()}`}
	description="Recebemos sua mensagem. Em breve entraremos em contato."
>
	<Header />
	<main class="ui-container max-w-3xl py-20 text-center md:py-28">
		<p class="ui-eyebrow">Contato</p>
		<h1 class="ui-heading mt-0">Mensagem enviada</h1>
		<p class="ui-lead mx-auto">
			Obrigado pelo contato. Em breve retornamos. Se preferir agilizar, fazer direto no WhatsApp.
		</p>
		<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a href={base} class="ui-btn-secondary ui-btn-block sm:w-auto">
				Voltar à página inicial
			</a>
			<div class="w-full sm:w-auto">
				<CtaButton label="Falar no WhatsApp" cta="obrigado" fullWidth />
			</div>
		</div>
	</main>
	<Footer />
</Layout>
