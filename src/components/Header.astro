---
import { site } from '../lib/site';
import CtaButton from './CtaButton.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const desktopLinks = [
	{ href: `${base}#beneficios`, label: 'Benefícios' },
	{ href: `${base}#como-funciona`, label: 'Como funciona' },
	{ href: `${base}#servicos`, label: 'Serviços' },
	{ href: `${base}#contato`, label: 'Contato' },
	{ href: `${base}#faq`, label: 'FAQ' },
];

const mobileLinks = [
	{ href: `${base}#servicos`, label: 'Serviços' },
	{ href: `${base}#contato`, label: 'Contato' },
	{ href: `${base}#faq`, label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-zinc-950/90 text-white backdrop-blur-md">
	<div class="ui-container flex items-center justify-between gap-3 py-3">
		<a href={base} class="inline-flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-white">
			<span class="flex size-8 items-center justify-center rounded-[var(--radius-control)] bg-amber-500 text-zinc-950" aria-hidden="true">
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" stroke-linejoin="round" />
				</svg>
			</span>
			<span class="text-amber-400">{site.name}</span>
		</a>

		<nav class="hidden items-center gap-6 text-sm text-zinc-300 lg:flex" aria-label="Seções">
			{
				desktopLinks.map((link) => (
					<a href={link.href} class="transition hover:text-white">
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<CtaButton label="WhatsApp" cta="header" />

			<details class="relative lg:hidden">
				<summary
					class="flex size-11 cursor-pointer list-none items-center justify-center rounded-[var(--radius-control)] border border-zinc-700 text-white marker:content-none [&::-webkit-details-marker]:hidden"
					aria-label="Abrir menu"
				>
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
					</svg>
				</summary>
				<div class="absolute right-0 mt-2 w-52 rounded-[var(--radius-card)] border border-zinc-800 bg-zinc-950 p-2">
					<nav class="flex flex-col" aria-label="Menu mobile">
						{
							mobileLinks.map((link) => (
								<a
									href={link.href}
									class="rounded-[var(--radius-control)] px-3 py-3 text-sm text-zinc-200 hover:bg-zinc-900 hover:text-white"
								>
									{link.label}
								</a>
							))
						}
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>
